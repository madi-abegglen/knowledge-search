ANTHROPIC_API_KEY=your-key-here
MODEL_NAME=claude-sonnet-5-5
CHROMA_PATH=./chroma_db
EMBED_MODEL=all-MiniLM-L6-v2
LOG_DIR=./logs
# Cost estimate for evals (leave blank to skip cost; set per million tokens)
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
# Monitoring (infra/report.py): leave blank to disable the cost alert / use an unsalted hash
DAILY_COST_LIMIT_USD=
QUERY_LOG_SALT=

# Prompt file the app uses: prompts/answer_v<N>.md (digits only). 1 is the default; 2 is a candidate, not adopted.
PROMPT_VERSION=1
